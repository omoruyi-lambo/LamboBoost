# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LamboBoost
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/lamboboost

# Auth
AUTH_SECRET=your-auth-secret-min-32-chars
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# Redis
REDIS_URL=redis://localhost:6379

# Payments - Paystack
PAYSTACK_SECRET_KEY=sk_live_xxx
PAYSTACK_PUBLIC_KEY=pk_live_xxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_xxx

# Payments - Flutterwave
FLUTTERWAVE_SECRET_KEY=FLWSECK_xxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_xxx
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_xxx

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Resend
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=noreply@lamboboost.com
RESEND_FROM_NAME=LamboBoost

# Security
CSRF_SECRET=your-csrf-secret-min-32-chars
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Provider (mock | providerA | providerB)
ACTIVE_PROVIDER=mock
